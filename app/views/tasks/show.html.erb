<%= tag.p(notice, class: "notice") if notice.present? %>
<% content_for :title, @task.title %>

<div class="page-header">
  <div>
    <h1><%= @task.title %></h1>
    <p class="page-subtitle">タスクの詳細、進捗、コメントを確認できます。</p>
  </div>
</div>

<%= render @task %>

<section class="card status-panel">
  <h2>ステータス変更</h2>
  <% next_status = { "open" => "in_progress", "in_progress" => "done" }[@task.status] %>
  <% if next_status %>
    <% next_label = { "in_progress" => "進行中へ", "done" => "完了へ" }[next_status] %>
    <%= button_to next_label, task_path(@task), method: :patch, params: { task: { status: next_status } }, class: "btn btn-primary" %>
  <% else %>
    <span class="badge status-done">✅ 完了済み</span>
  <% end %>
</section>

<section class="form-card">
  <h2>コメントを追加</h2>
  <%= render "comments/form", comment: Comment.new(task_id: @task.id) %>
</section>

<section>
  <div class="section-header">
    <div>
      <h2>コメント</h2>
      <p class="page-subtitle">最新のやり取りを確認できます。</p>
    </div>
  </div>

  <div id="comments" class="comment-list">
    <% if @task.comments.any? %>
      <%= render @task.comments %>
    <% else %>
      <div class="empty-state">まだコメントはありません。</div>
    <% end %>
  </div>
</section>

<div class="inline-actions" style="margin-top: 2rem;">
  <%= link_to "編集", edit_task_path(@task), class: "btn btn-secondary" %>
  <%= link_to "プロジェクトに戻る", @task.project, class: "btn btn-secondary" %>
  <%= button_to "削除", @task, method: :delete, class: "btn btn-danger", data: { turbo_confirm: "このタスクを削除しますか？" } %>
</div>
