<%= tag.p(notice, class: "notice") if notice.present? %>
<% content_for :title, "Comments" %>

<div class="page-header">
  <div>
    <h1>Comments</h1>
    <p class="page-subtitle">投稿されたコメントの一覧です。</p>
  </div>
  <%= link_to "New comment", new_comment_path, class: "btn btn-primary" %>
</div>

<% if @comments.any? %>
  <div id="comments" class="comment-list">
    <% @comments.each do |comment| %>
      <%= render comment %>
    <% end %>
  </div>
<% else %>
  <div class="empty-state">コメントはまだありません。</div>
<% end %>
