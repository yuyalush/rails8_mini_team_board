<%= tag.p(notice, class: "notice") if notice.present? %>
<% content_for :title, "Comment" %>

<div class="page-header">
  <div>
    <h1>Comment</h1>
    <p class="page-subtitle">コメントの詳細です。</p>
  </div>
</div>

<%= render @comment %>

<div class="inline-actions">
  <%= link_to "Edit this comment", edit_comment_path(@comment), class: "btn btn-secondary" %>
  <%= link_to "Back to comments", comments_path, class: "btn btn-secondary" %>
  <%= button_to "Destroy this comment", @comment, method: :delete, class: "btn btn-danger", data: { turbo_confirm: "このコメントを削除しますか？" } %>
</div>
