<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Mini Team Board" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Mini Team Board">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar">
      <div class="container navbar-inner">
        <div class="navbar-left">
          <%= link_to "Mini Team Board", root_path, class: "navbar-brand" %>
          <div class="navbar-links">
            <%= link_to "プロジェクト", projects_path, class: "navbar-link" %>
            <%= link_to "ダッシュボード", dashboard_path, class: "navbar-link" %>
          </div>
        </div>

        <% if Current.user %>
          <% unread_count = Notification.where(user: Current.user, read_at: nil).count %>
          <div class="navbar-user">
            <%= link_to notifications_path, class: "navbar-link" do %>
              <span>通知</span>
              <% if unread_count > 0 %>
                <span class="badge"><%= unread_count %></span>
              <% end %>
            <% end %>
            <span class="navbar-email"><%= Current.user.email_address %></span>
            <%= button_to "ログアウト", session_path, method: :delete, class: "btn btn-secondary btn-small" %>
          </div>
        <% end %>
      </div>
    </nav>

    <main class="container page-content">
      <%= yield %>
    </main>
  </body>
</html>
